.version 8.0
.target sm_89
.address_size 64

.visible .entry k_add_pointwise(
    .param .u64 param_add_c1,
    .param .u64 param_x,
    .param .u64 param_add
)
{
    .reg .pred %p<2>;
    .reg .f32 %f<3>;
    .reg .b32 %r<7>;
    .reg .b64 %rd<13>;
	ld.param.u64 %rd1, [param_add_c1];
	cvta.to.global.u64 %rd2, %rd1;
	ld.param.u64 %rd3, [param_x];
	cvta.to.global.u64 %rd4, %rd3;
	ld.param.u64 %rd5, [param_add];
	cvta.to.global.u64 %rd6, %rd5;
	mov.u32 %r1, %tid.x;
	mov.u32 %r2, %ctaid.x;
	mul.lo.s32 %r3, %r2, 256;
	add.s32 %r4, %r3, %r1;
	and.b32 %r5, %r1, 31;
	shr.u32 %r6, %r1, 5;
	mul.wide.s32 %rd7, %r4, 4;
	add.s64 %rd8, %rd4, %rd7;
	ld.global.f32 %f1, [%rd8];
	ld.global.f32 %f2, [%rd2];
	setp.gt.f32 %p1, %f1, 0f00000000;
	@!%p1 bra COND_ELSE_1;
	mul.wide.s32 %rd9, %r4, 4;
	add.s64 %rd10, %rd6, %rd9;
	st.global.f32 [%rd10], %f2;
	bra COND_END_2;
COND_ELSE_1:
	mul.wide.s32 %rd11, %r4, 4;
	add.s64 %rd12, %rd6, %rd11;
	st.global.f32 [%rd12], %f1;
COND_END_2:
	ret;
}
