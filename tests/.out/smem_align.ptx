.version 8.0
.target sm_89
.address_size 64

.extern .shared .align 16 .b8 __emmy_smem[];

.visible .entry k_add_pointwise(
    .param .u64 param_x,
    .param .u64 param_add
)
{
    .reg .pred %p<2>;
    .reg .f32 %f<5>;
    .reg .b32 %r<11>;
    .reg .b64 %rd<9>;
	ld.param.u64 %rd1, [param_x];
	cvta.to.global.u64 %rd2, %rd1;
	ld.param.u64 %rd3, [param_add];
	cvta.to.global.u64 %rd4, %rd3;
	mov.u32 %r1, %tid.x;
	mov.u32 %r2, %ctaid.x;
	and.b32 %r3, %r1, 31;
	shr.u32 %r4, %r1, 5;
	setp.ge.s32 %p1, %r1, 3;
	@%p1 bra DONE_1;
	mov.u32 %r5, __emmy_smem;
	mul.wide.s32 %rd5, %r1, 4;
	add.s64 %rd6, %rd2, %rd5;
	ld.global.f32 %f1, [%rd6];
	ld.global.f32 %f2, [%rd6+4];
	mul.lo.s32 %r6, %r1, 2;
	mul.lo.s32 %r8, %r6, 4;
	add.s32 %r7, %r5, %r8;
	st.shared.v2.f32 [%r7], {%f1, %f2};
	bar.sync 0;
	mul.lo.s32 %r10, %r6, 4;
	add.s32 %r9, %r5, %r10;
	ld.shared.f32 %f3, [%r9+4];
	ld.shared.f32 %f4, [%r9+4+4];
	mul.wide.s32 %rd7, %r6, 4;
	add.s64 %rd8, %rd4, %rd7;
	st.global.v2.f32 [%rd8], {%f3, %f4};
DONE_1:
	ret;
}
