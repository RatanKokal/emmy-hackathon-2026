.version 8.0
.target sm_89
.address_size 64

.visible .entry k_add_pointwise(
    .param .u64 param_add_c1,
    .param .u64 param_x,
    .param .u64 param_add
)
{
    .reg .pred %p<2>;
    .reg .f32 %f<4>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<9>;
	ld.param.u64 %rd1, [param_add_c1];
	cvta.to.global.u64 %rd2, %rd1;
	ld.param.u64 %rd3, [param_x];
	cvta.to.global.u64 %rd4, %rd3;
	ld.param.u64 %rd5, [param_add];
	cvta.to.global.u64 %rd6, %rd5;
	mov.u32 %r1, %tid.x;
	mov.u32 %r2, %ctaid.x;
	mul.lo.s32 %r3, %r2, 256;
	add.s32 %r4, %r3, %r1;
	and.b32 %r5, %r1, 31;
	shr.u32 %r6, %r1, 5;
	mov.s32 %r7, 0;
LOOP_2:
	setp.ge.s32 %p1, %r7, %r4;
	@%p1 bra LOOP_END_1;
	ld.global.f32 %f1, [%rd2];
	add.rn.f32 %f2, %f1, %f1;
	add.s32 %r7, %r7, 1;
	bra LOOP_2;
LOOP_END_1:
	ld.global.f32 %f3, [%rd2];
	mul.wide.s32 %rd7, %r4, 4;
	add.s64 %rd8, %rd6, %rd7;
	st.global.f32 [%rd8], %f3;
	ret;
}
