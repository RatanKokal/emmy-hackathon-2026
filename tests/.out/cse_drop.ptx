.version 8.0
.target sm_89
.address_size 64

.visible .entry k_add_pointwise(
    .param .u64 param_add_c1,
    .param .u64 param_x,
    .param .u64 param_add
)
{
    .reg .pred %p<3>;
    .reg .f32 %f<5>;
    .reg .b32 %r<17>;
    .reg .b64 %rd<27>;
	ld.param.u64 %rd1, [param_add_c1];
	cvta.to.global.u64 %rd2, %rd1;
	ld.param.u64 %rd3, [param_x];
	cvta.to.global.u64 %rd4, %rd3;
	ld.param.u64 %rd5, [param_add];
	cvta.to.global.u64 %rd6, %rd5;
	mov.u32 %r1, %tid.x;
	mov.u32 %r2, %ctaid.x;
	mul.lo.s32 %r3, %r2, 256;
	add.s32 %r4, %r3, %r1;
	and.b32 %r5, %r1, 31;
	shr.u32 %r6, %r1, 5;
	mul.wide.s32 %rd7, %r4, 4;
	add.s64 %rd8, %rd4, %rd7;
	ld.global.s32 %r7, [%rd8];
	ld.global.s32 %r8, [%rd2];
	add.s32 %r9, %r7, %r8;
	add.s32 %r10, %r8, %r7;
	ld.global.f32 %f1, [%rd2];
	mul.wide.s32 %rd9, %r4, 4;
	add.s64 %rd10, %rd4, %rd9;
	ld.global.f32 %f2, [%rd10];
	setp.gt.s32 %p1, %r9, 0;
	@!%p1 bra COND_ELSE_1;
	mul.wide.s32 %rd11, %r4, 4;
	add.s64 %rd12, %rd6, %rd11;
	st.global.f32 [%rd12], %f1;
	bra COND_END_2;
COND_ELSE_1:
	mul.wide.s32 %rd13, %r4, 4;
	add.s64 %rd14, %rd6, %rd13;
	st.global.f32 [%rd14], %f2;
COND_END_2:
	add.s32 %r11, %r10, %r10;
	mul.wide.s32 %rd15, %r4, 4;
	add.s64 %rd16, %rd6, %rd15;
	st.global.s32 [%rd16], %r11;
	mul.wide.s32 %rd17, %r4, 4;
	add.s64 %rd18, %rd4, %rd17;
	ld.global.s32 %r12, [%rd18];
	ld.global.s32 %r13, [%rd2];
	add.s32 %r14, %r12, %r13;
	add.s32 %r15, %r13, %r12;
	ld.global.f32 %f3, [%rd2];
	mul.wide.s32 %rd19, %r4, 4;
	add.s64 %rd20, %rd4, %rd19;
	ld.global.f32 %f4, [%rd20];
	setp.gt.s32 %p2, %r14, 0;
	@!%p2 bra COND_ELSE_3;
	mul.wide.s32 %rd21, %r4, 4;
	add.s64 %rd22, %rd6, %rd21;
	st.global.f32 [%rd22], %f3;
	bra COND_END_4;
COND_ELSE_3:
	mul.wide.s32 %rd23, %r4, 4;
	add.s64 %rd24, %rd6, %rd23;
	st.global.f32 [%rd24], %f4;
COND_END_4:
	add.s32 %r16, %r15, %r15;
	mul.wide.s32 %rd25, %r4, 4;
	add.s64 %rd26, %rd6, %rd25;
	st.global.s32 [%rd26], %r16;
	ret;
}
