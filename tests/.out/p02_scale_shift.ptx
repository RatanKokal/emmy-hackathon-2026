.version 8.0
.target sm_89
.address_size 64

.visible .entry k_add_pointwise(
    .param .u64 param_mul_c1,
    .param .u64 param_add_c1,
    .param .u64 param_x,
    .param .u64 param_add
)
{
    .reg .f32 %f<21>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<15>;
	ld.param.u64 %rd1, [param_mul_c1];
	cvta.to.global.u64 %rd2, %rd1;
	ld.param.u64 %rd3, [param_add_c1];
	cvta.to.global.u64 %rd4, %rd3;
	ld.param.u64 %rd5, [param_x];
	cvta.to.global.u64 %rd6, %rd5;
	ld.param.u64 %rd7, [param_add];
	cvta.to.global.u64 %rd8, %rd7;
	mov.u32 %r1, %tid.x;
	mov.u32 %r2, %ctaid.x;
	mul.lo.s32 %r3, %r2, 256;
	add.s32 %r4, %r3, %r1;
	and.b32 %r5, %r1, 31;
	shr.u32 %r6, %r1, 5;
	ld.global.f32 %f1, [%rd2];
	mul.lo.s32 %r7, %r4, 4;
	mul.wide.s32 %rd9, %r7, 4;
	add.s64 %rd10, %rd6, %rd9;
	ld.global.v2.f32 {%f2, %f3}, [%rd10];
	mul.rn.f32 %f4, %f1, %f2;
	ld.global.f32 %f5, [%rd4];
	add.rn.f32 %f6, %f5, %f4;
	ld.global.f32 %f7, [%rd2];
	mul.rn.f32 %f8, %f7, %f3;
	ld.global.f32 %f9, [%rd4];
	add.rn.f32 %f10, %f9, %f8;
	ld.global.f32 %f11, [%rd2];
	mul.wide.s32 %rd11, %r7, 4;
	add.s64 %rd12, %rd6, %rd11;
	ld.global.v2.f32 {%f12, %f13}, [%rd12+8];
	mul.rn.f32 %f14, %f11, %f12;
	ld.global.f32 %f15, [%rd4];
	add.rn.f32 %f16, %f15, %f14;
	ld.global.f32 %f17, [%rd2];
	mul.rn.f32 %f18, %f17, %f13;
	ld.global.f32 %f19, [%rd4];
	add.rn.f32 %f20, %f19, %f18;
	mul.wide.s32 %rd13, %r7, 4;
	add.s64 %rd14, %rd8, %rd13;
	st.global.v4.f32 [%rd14], {%f6, %f10, %f16, %f20};
	ret;
}
